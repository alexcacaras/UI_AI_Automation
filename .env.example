# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real values.

# Oracle Fusion environment to open (include https://)
BASE_URL=

# Local Ollama model used by the AI decider / healer
MODEL=

# Capture a screenshot per replay step and build a .docx report: on / off
SCREENSHOTS=off

# --- Phase 6 healer -------------------------------------------------------
# Repairs a replay step whose locator no longer resolves. Runs ONLY where the
# run would otherwise die, never on the hot path.
HEALER=on

# Where the healer's model runs. Local Ollama is the default and should stay
# that way: a heal prompt carries the page's element names, which on a Fusion
# page can include real employee names.
HEALER_PROVIDER=ollama

# Model for healing. Falls back to MODEL if unset. The healer wants long-list
# attention and the discipline to answer -1; that is not the same job as the
# AI driver, so it is worth setting separately.
HEALER_MODEL=

# num_ctx. THE TRAP: a model's advertised context is what it CAN do, but Ollama
# allocates only this per request and its own default is small. Go over it and
# the prompt is truncated SILENTLY — the model then answers confidently from a
# page it only half received, and looks stupid for no reason.
HEALER_NUM_CTX=16384

# 0 = deterministic. Healing is a lookup, not composition, and a regression tool
# should give the same answer twice.
HEALER_TEMPERATURE=0

# Consecutive heals allowed before the healer stands down. Heals back to back
# mean each one is judging a page the previous heal navigated to — once one is
# wrong the rest are garbage.
HEALER_MAX_CONSECUTIVE=3
